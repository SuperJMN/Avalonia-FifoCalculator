<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FIFOCalculator.ViewModels"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="120"
             x:DataType="viewModels:PasswordPromptViewModel"
             x:Class="FIFOCalculator.Views.PasswordPromptView">
    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <TextBox Text="{Binding Password, Mode=TwoWay}"
                 Theme="{StaticResource PasswordBox}"
                 PlaceholderText="Password" />
    </StackPanel>
</UserControl>
