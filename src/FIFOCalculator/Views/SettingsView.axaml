<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FIFOCalculator.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:SettingsViewModel"
             x:Class="FIFOCalculator.Views.SettingsView">

    <StackPanel Margin="16" Spacing="16">
        <TextBlock Text="Data" FontWeight="Bold" />
        <StackPanel Spacing="8">
            <EnhancedButton Content="Import data file"
                            Classes="Secondary"
                            Icon="{Icon fa-file-import}"
                            Command="{Binding ImportDataFile}" />
            <EnhancedButton Content="Clear data"
                            Classes="Destructive"
                            Icon="{Icon fa-trash}"
                            Command="{Binding ClearData}" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding IsSyncSupported}">
            <TextBlock Text="Sync" FontWeight="Bold" />
            <TextBlock Text="{Binding SyncStatusLine}" TextWrapping="Wrap" />
            <EnhancedButton Content="Create identity"
                            IsVisible="{Binding CanCreateSyncIdentity}"
                            Classes="Primary"
                            Icon="{Icon fa-plus}"
                            Command="{Binding CreateSyncIdentity}" />
            <EnhancedButton Content="Unlock"
                            IsVisible="{Binding CanUnlockSync}"
                            Classes="Primary"
                            Icon="{Icon fa-lock-open}"
                            Command="{Binding UnlockSync}" />
            <EnhancedButton Content="Import identity"
                            Classes="Secondary"
                            Icon="{Icon fa-file-import}"
                            Command="{Binding ImportSyncIdentity}" />
            <EnhancedButton Content="Export identity"
                            IsVisible="{Binding CanExportSyncIdentity}"
                            Classes="Secondary"
                            Icon="{Icon fa-file-export}"
                            Command="{Binding ExportSyncIdentity}" />
            <EnhancedButton Content="Sync now"
                            IsVisible="{Binding CanSyncNow}"
                            Classes="Secondary"
                            Icon="{Icon fa-arrows-rotate}"
                            Command="{Binding SyncNow}" />
            <EnhancedButton Content="Resolve conflict"
                            IsVisible="{Binding HasSyncConflict}"
                            Classes="Primary"
                            Icon="{Icon fa-triangle-exclamation}"
                            Command="{Binding ResolveSyncConflict}" />
            <EnhancedButton Content="Disconnect"
                            IsVisible="{Binding CanDisconnectSync}"
                            Classes="Destructive"
                            Icon="{Icon fa-link-slash}"
                            Command="{Binding DisconnectSync}" />
        </StackPanel>
    </StackPanel>
</UserControl>
